@using FinalProject_Store.Application.Services.Users.Queries.GetUsers;
@model ResultGetUserDto;
@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_Adminlayout.cshtml";
    int.TryParse(Context.Request.Query["page"], out var requestedPage);
    var currentPage = Math.Max(1, requestedPage);
    var pageCount = Math.Max(1, (int)Math.Ceiling(Model.Rows / 20d));
    var firstRow = Model.Users.Count == 0 ? 0 : (currentPage - 1) * 20 + 1;
    var lastRow = Model.Users.Count == 0 ? 0 : firstRow + Model.Users.Count - 1;
}

<div class="content-wrapper">
    <div class="container-fluid">
        <!-- Zero configuration table -->
        <section id="configuration">
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <div class="card-title-wrap bar-success">
                                <h4 class="card-title">لیست کاربران</h4>
                            </div>
                        </div>
                        <div class="card-body collapse show">
                            <div class="card-block card-dashboard">
                                <p class="card-text">برای جستجوی کاربران، نام یا ایمیل را وارد کنید.</p>
                                <div id="DataTables_Table_0_wrapper" class="dataTables_wrapper container-fluid dt-bootstrap4">
                                    <div class="row">
                                        <div class="col-sm-12 col-md-6">
                                            <div class="dataTables_length" id="DataTables_Table_0_length">
                                                <span>۲۰ سطر در هر صفحه</span>
                                            </div>
                                        </div>
                                        <div class="col-sm-12 col-md-6">
                                            <div id="DataTables_Table_0_filter" class="dataTables_filter">
                                                <form method="get"
                                                      asp-area="Admin"
                                                      asp-controller="Users"
                                                      asp-action="Index"
                                                      class="d-flex flex-wrap align-items-center justify-content-md-end"
                                                      style="gap: 6px;">

                                                    <label class="mb-0">جستجو:</label>

                                                    <input type="search"
                                                           name="searchKey"
                                                           class="form-control form-control-sm"
                                                           value="@Context.Request.Query["searchKey"]"
                                                           placeholder="نام یا ایمیل کاربر"
                                                           style="width: 180px;" />

                                                    <button type="submit" class="btn btn-info btn-sm">
                                                        جستجو
                                                    </button>

                                                    <a href="/Admin/Users/Index" class="btn btn-secondary btn-sm">
                                                        نمایش همه
                                                    </a>
                                                </form>
                                            </div>
                                        </div>

                                    </div><div class="row">
                                        <div class="col-sm-12">
                                            <div class="table-responsive">
                                            <table class="table table-striped table-bordered zero-configuration dataTable" id="DataTables_Table_0" role="grid" aria-describedby="DataTables_Table_0_info">
                                                <thead>
                                                    <tr role="row">
                                                        <th class="sorting_asc" tabindex="0" aria-controls="DataTables_Table_0" rowspan="1" colspan="1" aria-sort="ascending" aria-label="نام: activate to sort column descending" style="width: 157.2px;">نام</th>
                                                        <th class="sorting" tabindex="0" aria-controls="DataTables_Table_0" rowspan="1" colspan="1" aria-label="موقعیت: activate to sort column ascending" style="width: 293.25px;">ایمیل</th>
                                                        <th scope="col">عملیات</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var item in Model.Users)
                                                    {
                                                        <tr role="row" class="odd">
                                                            <td class="sorting_1">@item.FullName</td>
                                                            <td>@item.Email</td>
                                                            <td>
                                                                <button class="btn btn-info"
                                                                        data-user-id="@item.Id" data-full-name="@item.FullName" data-email="@item.Email" onclick="ShowModalEdituser(this.dataset.userId, this.dataset.fullName, this.dataset.email)">
                                                                    ویرایش
                                                                </button>

                                                                <button type="button"
                                                                        class="btn btn-danger"
                                                                        onclick="DeleteUser(@item.Id)">
                                                                    حذف
                                                                </button>

                                                                @if (item.isActive)
                                                                {
                                                                    <button type="button" class="btn btn-warning" onclick="UserStatusChange(@item.Id)">
                                                                        غیرفعال
                                                                    </button>
                                                                }
                                                                else
                                                                {
                                                                    <button type="button" class="btn btn-success" onclick="UserStatusChange(@item.Id)">
                                                                        فعال
                                                                    </button>
                                                                }
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row align-items-center">
                                        <div class="col-sm-12 col-md-5">
                                            <div class="dataTables_info" id="DataTables_Table_0_info" role="status" aria-live="polite">نمایش @firstRow تا @lastRow از @Model.Rows سطرها</div>
                                        </div>
                                        <div class="col-sm-12 col-md-7">
                                            <nav aria-label="صفحه‌بندی کاربران">
                                                <ul class="pagination flex-wrap justify-content-end">
                                                    @if (currentPage > 1) {
                                                        <li class="page-item"><a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-searchKey="@Context.Request.Query["searchKey"]">قبلی</a></li>
                                                    }
                                                    <li class="page-item disabled"><span class="page-link">صفحه @currentPage از @pageCount</span></li>
                                                    @if (currentPage < pageCount) {
                                                        <li class="page-item"><a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-searchKey="@Context.Request.Query["searchKey"]">بعدی</a></li>
                                                    }
                                                </ul>
                                            </nav>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>

<style>
    .modal-backdrop {
        z-index: 99998 !important;
    }

    #EditUserModal {
        z-index: 99999 !important;
    }
</style>
@section Modals
{
    <div class="modal fade show" id="EditUserModal" tabindex="-1" role="dialog" aria-labelledby="EditUserModalLabel"
         aria-hidden="true" style="display:none; z-index:99999;">
        <div class="modal-dialog" role="document">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title" id="EditUserModalLabel">ویرایش کاربر</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="Edit_UserId" />
                    <div class="form-group">
                        <label>نام و نام خانوادگی</label>
                        <input type="text" class="form-control" id="Edit_FullName" />
                    </div>
                    <div class="form-group">
                        <label>ایمیل</label>
                        <input type="text" class="form-control" id="Edit_Email" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">بستن</button>
                    <button type="button" class="btn btn-success" onclick="EditUser()">ذخیره تغییرات</button>
                </div>
            </div>
        </div>
    </div>
}
@section Scripts
{
    <link href="~/Sweetalert2/sweetalert2.min.css" rel="stylesheet" />
    <script src="~/Sweetalert2/sweetalert2.min.js"></script>

    <script>
                function DeleteUser(UserId) {
            Swal.fire({
                title: 'حذف کاربر',
                text: 'کاربر گرامی از حذف کاربر مطمئن هستید؟',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#7cacbe',
                confirmButtonText: 'بله، کاربر حذف شود',
                cancelButtonText: 'خیر'
            }).then((result) => {

                if (result.value) {

                    $.ajax({
                        contentType: 'application/x-www-form-urlencoded',
                        dataType: 'json',
                        type: 'POST',
                        url: '/Admin/Users/Delete',

                        data: {
                            UserId: UserId
                        },

                        success: function (data) {

                            if (data.isSuccess === true) {
                                Swal.fire(
                                    'موفق!',
                                    data.message,
                                    'success'
                                ).then(function () {
                                    location.reload();
                                });
                            }
                            else {
                                Swal.fire(
                                    'هشدار!',
                                    data.message,
                                    'warning'
                                );
                            }
                        },

                        error: function (request, status, error) {
                            Swal.fire(
                                'خطا!',
                                request.responseText || 'در ارتباط با سرور مشکلی رخ داد',
                                'error'
                            );
                        }
                    });
                }
            });
        }

        function UserStatusChange(UserId) {
            $.ajax({
                type: "POST",
                url: "/Admin/Users/UserStatusChange",
                data: {
                    UserId: UserId
                },
                success: function (data) {
                    if (data.isSuccess == true) {
                        location.reload();
                    }
                    else {
                        alert(data.message);
                    }
                },
                error: function (request) {
                    alert(request.responseText);
                }
            });
        }

        function ShowModalEdituser(userId, fullName, email) {
            $("#Edit_UserId").val(userId);
            $("#Edit_FullName").val(fullName);
            $("#Edit_Email").val(email);

            $("#EditUserModal").appendTo("body").modal("show");
        }

        function EditUser() {
            var userId = $("#Edit_UserId").val();
            var fullName = $("#Edit_FullName").val();
            var email = $("#Edit_Email").val();
            $.ajax({
                contentType: 'application/x-www-form-urlencoded',
                dataType: 'json',
                type: "POST",
                url: "/Admin/Users/Edit",
                data: {
                    UserId: userId,
                    FullName: fullName,
                    Email: email
                },
                success: function (data) {
                    if (data.isSuccess == true) {
                        $("#EditUserModal").modal("hide");
                        location.reload();
                    }
                    else {
                        alert(data.message);
                    }
                },
                error: function (request) {
                    alert(request.responseText);
                }
            });
        }
    </script>
}
