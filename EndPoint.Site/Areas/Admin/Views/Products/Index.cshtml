@using FinalProject_Store.Application.Services.Products.Queries
@model GetProductsResultDto

@{
    ViewData["Title"] = "مدیریت محصولات";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var successMessage = TempData["SuccessMessage"]?.ToString();
}

<div class="content-wrapper">
    <div class="content-header row">
        <div class="content-header-left col-md-6 col-12 mb-2">
            <h3 class="content-header-title">مدیریت محصولات</h3>
        </div>
    </div>
    <div class="content-body">
        <section class="card">
            <div class="card-header"><h4 class="card-title">فهرست محصولات</h4></div>
            <div class="card-content">
                <div class="card-body">
                    <div class="row mb-2">
                        <div class="col-md-5">
                            <a asp-action="Create" class="btn btn-success">ثبت محصول جدید</a>
                        </div>
                        <div class="col-md-7">
                            <form method="get" asp-action="Index" class="d-flex justify-content-md-end" style="gap:6px">
                                <input type="search" name="searchKey" value="@Model.SearchKey"
                                       class="form-control form-control-sm" style="max-width:260px"
                                       placeholder="جستجو در نام یا برند" />
                                <button type="submit" class="btn btn-info btn-sm">جستجو</button>
                                <a asp-action="Index" class="btn btn-secondary btn-sm">نمایش همه</a>
                            </form>
                        </div>
                    </div>

                    <form id="productActionForm">@Html.AntiForgeryToken()</form>
                    @if (Model.Products.Count == 0)
                    {
                        <div class="alert alert-warning text-center">محصولی مطابق با جستجوی شما یافت نشد.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-bordered">
                                <thead><tr><th>نام محصول</th><th>برند</th><th>قیمت</th><th>موجودی</th><th>دسته‌بندی</th><th>وضعیت</th><th>عملیات</th></tr></thead>
                                <tbody>
                                @foreach (var item in Model.Products)
                                {
                                    <tr>
                                        <td>@item.Name</td><td>@item.Brand</td><td>@item.Price.ToString("N0")</td>
                                        <td>@item.Inventory</td><td>@item.CategoryName</td>
                                        <td>@if (item.IsActive) { <span class="badge badge-success">فعال</span> } else { <span class="badge badge-danger">غیرفعال</span> }</td>
                                        <td class="text-nowrap">
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-info btn-sm">ویرایش</a>
                                            <button type="button" class="btn @(item.IsActive ? "btn-warning" : "btn-success") btn-sm"
                                                    onclick="changeStatus(@item.Id, '@(item.IsActive ? "غیرفعال" : "فعال")')">
                                                @(item.IsActive ? "غیرفعال" : "فعال")
                                            </button>
                                            <button type="button" class="btn btn-danger btn-sm" onclick="deleteProduct(@item.Id)">حذف</button>
                                        </td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>

                        @if (Model.PageCount > 1)
                        {
                            <nav><ul class="pagination justify-content-center">
                                <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page - 1)" asp-route-searchKey="@Model.SearchKey">قبلی</a>
                                </li>
                                @for (var pageNumber = 1; pageNumber <= Model.PageCount; pageNumber++)
                                {
                                    <li class="page-item @(pageNumber == Model.Page ? "active" : "")">
                                        <a class="page-link" asp-action="Index" asp-route-page="@pageNumber" asp-route-searchKey="@Model.SearchKey">@pageNumber</a>
                                    </li>
                                }
                                <li class="page-item @(Model.Page >= Model.PageCount ? "disabled" : "")">
                                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page + 1)" asp-route-searchKey="@Model.SearchKey">بعدی</a>
                                </li>
                            </ul></nav>
                        }
                    }
                </div>
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <link href="~/Sweetalert2/sweetalert2.min.css" rel="stylesheet" />
    <script src="~/Sweetalert2/sweetalert2.min.js"></script>
    <script>
        const token = () => document.querySelector('#productActionForm input[name="__RequestVerificationToken"]').value;
        function postAction(url, productId) {
            return $.ajax({ type: 'POST', url: url, data: { productId: productId, __RequestVerificationToken: token() } });
        }
        function changeStatus(id, actionTitle) {
            Swal.fire({ title: actionTitle + ' کردن محصول', text: 'آیا از تغییر وضعیت این محصول مطمئن هستید؟', icon: 'warning',
                showCancelButton: true, confirmButtonText: 'بله', cancelButtonText: 'خیر' }).then(result => {
                if (result.value) postAction('/Admin/Products/StatusChange', id).done(showResult).fail(showError);
            });
        }
        function deleteProduct(id) {
            Swal.fire({ title: 'حذف محصول', text: 'این محصول به‌صورت نرم حذف خواهد شد. آیا مطمئن هستید؟', icon: 'warning',
                showCancelButton: true, confirmButtonColor: '#d33', confirmButtonText: 'بله، حذف شود', cancelButtonText: 'خیر' }).then(result => {
                if (result.value) postAction('/Admin/Products/Delete', id).done(showResult).fail(showError);
            });
        }
        function showResult(result) {
            Swal.fire(result.isSuccess ? 'موفق!' : 'هشدار!', result.message, result.isSuccess ? 'success' : 'warning')
                .then(() => { if (result.isSuccess) location.reload(); });
        }
        function showError(request) { Swal.fire('خطا!', request.responseText || 'در ارتباط با سرور مشکلی رخ داد.', 'error'); }
    </script>
    @if (!string.IsNullOrWhiteSpace(successMessage)) {
        <script>Swal.fire('موفق!', @Html.Raw(System.Text.Json.JsonSerializer.Serialize(successMessage)), 'success');</script>
    }
}
