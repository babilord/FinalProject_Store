@using FinalProject_Store.Application.Services.Products.Queries.CustomerCatalog
@model CustomerProductsResultDto
@{
    ViewData["Title"] = "فهرست محصولات";
}

<main class="main-content dt-sl mb-3">
    <div class="container main-container">
        <div class="row mt-4">
            <div class="col-12">
                <div class="card shadow-sm border-0 mb-3">
                    <div class="card-body">
                        <h1 class="h4 mb-3">فهرست محصولات</h1>
                        <form method="get" asp-controller="Products" asp-action="Index">
                            <div class="row align-items-end">
                                <div class="col-lg-6 col-md-6 mb-2">
                                    <label for="catalogSearch">جستجوی محصول</label>
                                    <input id="catalogSearch" type="search" name="searchKey" value="@Model.SearchKey"
                                           class="form-control" maxlength="300" placeholder="نام محصول یا برند" />
                                </div>
                                <div class="col-lg-4 col-md-4 mb-2">
                                    <label for="catalogCategory">دسته‌بندی</label>
                                    <select id="catalogCategory" name="categoryId" class="form-control">
                                        <option value="">همه دسته‌بندی‌ها</option>
                                        @foreach (var category in Model.Categories)
                                        {
                                            if (Model.CategoryId == category.Id)
                                            {
                                                <option value="@category.Id" selected>@category.Name</option>
                                            }
                                            else
                                            {
                                                <option value="@category.Id">@category.Name</option>
                                            }
                                        }
                                    </select>
                                </div>
                                <div class="col-lg-2 col-md-2 mb-2 d-flex">
                                    <button type="submit" class="btn btn-primary ml-1 flex-grow-1">جستجو</button>
                                    <a asp-action="Index" class="btn btn-outline-secondary" title="حذف فیلترها">پاک کردن</a>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        @if (Model.Products.Count == 0)
        {
            <div class="alert alert-light text-center shadow-sm py-5">
                <i class="mdi mdi-package-variant-closed d-block mb-2" style="font-size:48px;color:#aaa"></i>
                محصولی مطابق با جستجوی شما یافت نشد.
            </div>
        }
        else
        {
            <div class="row">
                @foreach (var product in Model.Products)
                {
                    <div class="col-xl-3 col-lg-4 col-md-6 col-sm-6 mb-3">
                        <article class="card catalog-product-card h-100 border-0 shadow-sm">
                            <a asp-controller="Products"
                               asp-action="Details"
                               asp-route-id="@product.Id"
                               class="catalog-image-link">

                                @if (string.IsNullOrWhiteSpace(product.ImageSrc))
                                {
                                    <span class="catalog-placeholder"
                                          role="img"
                                          aria-label="تصویر محصول موجود نیست">
                                        <i class="mdi mdi-image-off"></i>
                                        <small>بدون تصویر</small>
                                    </span>
                                }
                                else
                                {
                                    <img src="@Url.Action("Image", "Products", new { id = product.Id })"
                                         class="card-img-top catalog-product-image"
                                         alt="@product.Name"
                                         onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />

                                    <span class="catalog-placeholder"
                                          style="display:none"
                                          role="img"
                                          aria-label="تصویر محصول موجود نیست">
                                        <i class="mdi mdi-image-off"></i>
                                        <small>بدون تصویر</small>
                                    </span>
                                }
                            </a>
                            <div class="card-body d-flex flex-column">
                                <span class="text-muted small mb-1">@product.CategoryName</span>
                                <h2 class="h6 mb-2 catalog-product-title">
                                    <a asp-controller="Products" asp-action="Details" asp-route-id="@product.Id">@product.Name</a>
                                </h2>
                                @if (!string.IsNullOrWhiteSpace(product.Brand))
                                {
                                    <div class="small text-muted mb-2">برند: @product.Brand</div>
                                }
                                <div class="mt-auto">
                                    <div class="text-success small mb-2"><i class="mdi mdi-check-circle"></i> موجود در انبار</div>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <strong class="catalog-price">@product.Price.ToString("N0") <small>تومان</small></strong>
                                        <a asp-controller="Products" asp-action="Details" asp-route-id="@product.Id" class="btn btn-outline-primary btn-sm">مشاهده محصول</a>
                                    </div>
                                </div>
                            </div>
                        </article>
                    </div>
                }
            </div>

            @if (Model.PageCount > 1)
            {
                <nav aria-label="صفحه‌بندی محصولات" class="mt-3">
                    <ul class="pagination justify-content-center">
                        <li class="page-item @(Model.Page <= 1 ? "disabled" : string.Empty)">
                            <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page - 1)"
                               asp-route-searchKey="@Model.SearchKey" asp-route-categoryId="@Model.CategoryId">قبلی</a>
                        </li>
                        @for (var pageNumber = 1; pageNumber <= Model.PageCount; pageNumber++)
                        {
                            <li class="page-item @(pageNumber == Model.Page ? "active" : string.Empty)">
                                <a class="page-link" asp-action="Index" asp-route-page="@pageNumber"
                                   asp-route-searchKey="@Model.SearchKey" asp-route-categoryId="@Model.CategoryId">@pageNumber</a>
                            </li>
                        }
                        <li class="page-item @(Model.Page >= Model.PageCount ? "disabled" : string.Empty)">
                            <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page + 1)"
                               asp-route-searchKey="@Model.SearchKey" asp-route-categoryId="@Model.CategoryId">بعدی</a>
                        </li>
                    </ul>
                </nav>
            }
        }
    </div>
</main>

<style>
    .catalog-product-card { border-radius: 10px; overflow: hidden; transition: transform .2s ease, box-shadow .2s ease; }
    .catalog-product-card:hover { transform: translateY(-3px); box-shadow: 0 8px 22px rgba(0,0,0,.09) !important; }
    .catalog-image-link { display: block; height: 230px; background: #fff; }
    .catalog-product-image { width: 100%; height: 230px; object-fit: contain; padding: 15px; }
    .catalog-placeholder { height: 230px; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #a8a8a8; background: #f6f6f6; }
    .catalog-placeholder i { font-size: 54px; line-height: 1; }
    .catalog-product-title { line-height: 1.8; min-height: 52px; }
    .catalog-product-title a { color: #333; }
    .catalog-product-title a:hover { color: #00bfd6; }
    .catalog-price { color: #ef394e; font-size: 16px; }
</style>
