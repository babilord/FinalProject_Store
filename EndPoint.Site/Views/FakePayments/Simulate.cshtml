@using FinalProject_Store.Domain.Entities.Payments
@model Payment
@{ ViewData["Title"] = "درگاه پرداخت آزمایشی"; }
<main class="main-content dt-sl mb-3"><div class="container main-container py-4" dir="rtl">
    <div class="card border-0 shadow-sm"><div class="card-body text-center">
        <h1 class="h4">درگاه پرداخت آزمایشی (Fake / Test)</h1>
        <div class="alert alert-warning">این درگاه محلی و آزمایشی است. هیچ پولی منتقل نمی‌شود و اطلاعات کارت دریافت نمی‌شود.</div>
        <p>شماره سفارش: @Model.OrderId</p>
        <p>مبلغ پرداخت: <strong>@Model.Amount.ToString("N0") تومان</strong></p>
        <form asp-action="Complete" method="post">
            <input type="hidden" name="token" value="@Model.Token" />
            <button class="btn btn-success m-2" name="outcome" value="Succeeded">پرداخت موفق</button>
            <button class="btn btn-danger m-2" name="outcome" value="Failed">پرداخت ناموفق</button>
            <button class="btn btn-outline-secondary m-2" name="outcome" value="Cancelled">انصراف از پرداخت</button>
        </form>
        <a asp-controller="Orders" asp-action="Details" asp-route-id="@Model.OrderId">بازگشت به سفارش</a>
    </div></div>
</div></main>
