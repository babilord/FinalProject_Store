@model ErrorViewModel
@{ ViewData["Title"] = "خطای سامانه"; }
<main class="main-content dt-sl"><div class="container main-container py-5"><div class="card"><div class="card-body text-center">
<h1 class="h4">خطایی در انجام درخواست رخ داد</h1><p>لطفاً کمی بعد دوباره تلاش کنید.</p>
@if (Model.ShowRequestId) { <p>شناسه پیگیری: <span dir="ltr">@Model.RequestId</span></p> }
<a asp-controller="Home" asp-action="Index" class="btn btn-primary">بازگشت به خانه</a>
</div></div></div></main>
