@using FinalProject_Store.Application.Services.Orders
@using FinalProject_Store.Domain.Entities.Orders
@using FinalProject_Store.Domain.Entities.Payments
@model OrderDetailsDto
@inject EndPoint.Site.Services.OrderDisplayTime OrderDisplayTime
@{ ViewData["Title"] = "جزئیات سفارش"; string StatusText(OrderStatus s) => OrderRules.Label(s); }
<main class="main-content dt-sl mb-3"><div class="container main-container py-4">
 @if (TempData["OrderSuccess"] is string success) { <div class="alert alert-success">@success</div> }
 <div class="d-flex justify-content-between mb-3"><h1 class="h4">سفارش شماره @Model.Id</h1><a asp-action="Index" class="btn btn-outline-secondary">سفارش‌های من</a></div>
 <div class="card border-0 shadow-sm mb-3"><div class="card-body"><div class="row"><div class="col-md-4"><strong>وضعیت:</strong> @StatusText(Model.Status)</div><div class="col-md-4"><strong>تاریخ:</strong> @Model.InsertTime.ToString("yyyy/MM/dd HH:mm")</div><div class="col-md-4"><strong>مبلغ:</strong> <span class="text-danger">@Model.Total.ToString("N0") تومان</span></div></div></div></div>
 @if (TempData["PaymentMessage"] is string paymentMessage) { <div class="alert alert-info">@paymentMessage</div> }
 <div class="card border-0 shadow-sm mb-3"><div class="card-body">
 @if (Model.CanPay)
 {
     @if (Model.LastPaymentStatus == PaymentStatus.Failed) { <p class="text-danger">پرداخت قبلی ناموفق بود. دوباره تلاش کنید.</p> }
     @if (Model.LastPaymentStatus == PaymentStatus.Cancelled) { <p class="text-warning">پرداخت قبلی لغو شد. می‌توانید دوباره پرداخت کنید.</p> }
     <p>مهلت پرداخت (به وقت محلی ایران): <time dir="ltr">@OrderDisplayTime.FromUtc(Model.ExpiresAtUtc).ToString("yyyy/MM/dd HH:mm")</time></p>
     <form asp-controller="Payments" asp-action="Pay" method="post">
         <input type="hidden" name="orderId" value="@Model.Id" />
         <button type="submit" class="btn btn-info">پرداخت سفارش</button>
     </form>
 }
 else if (Model.Status is OrderStatus.Paid or OrderStatus.Processing or OrderStatus.Shipped or OrderStatus.Delivered)
 {
     <strong class="text-success">پرداخت شده</strong>
     @if (!string.IsNullOrWhiteSpace(Model.PaymentReference)) { <p>شماره پیگیری: <span dir="ltr" class="text-break">@Model.PaymentReference</span></p> }
 }
 @if (Model.Status == OrderStatus.PendingPayment) {
 <form asp-action="Cancel" method="post" class="mt-3"><input type="hidden" name="id" value="@Model.Id" /><button type="submit" class="btn btn-outline-danger">لغو سفارش و آزادسازی موجودی</button></form>
 }
 @if (Model.ReservationExpired) { <p class="text-warning mt-3">مهلت پرداخت تمام شد؛ سفارش لغو و موجودی آزاد شد.</p> }
 else if (Model.Status == OrderStatus.PendingPayment && !Model.CanPay) { <p class="text-warning mt-3">مهلت رزرو تمام شده است. پرداخت امکان‌پذیر نیست؛ موجودی به‌صورت خودکار آزاد می‌شود.</p> }
 else if (Model.Status == OrderStatus.Cancelled) { <p>سفارش لغو شده است.</p> }
 </div></div>
 <div class="card border-0 shadow-sm mb-3"><div class="card-body"><h2 class="h5">اقلام سفارش</h2>@foreach(var item in Model.Items){<div class="d-flex align-items-center border-bottom py-3"><img src="@Url.Action("Image", "Products", new { id=item.ProductId })" alt="@item.ProductName" style="width:72px;height:72px;object-fit:contain" class="ml-3"/><div><strong>@item.ProductName</strong><div>@item.Quantity عدد × @item.UnitPrice.ToString("N0") تومان</div><div class="text-danger">@item.LineTotal.ToString("N0") تومان</div></div></div>}</div></div>
 <div class="card border-0 shadow-sm"><div class="card-body"><h2 class="h5">اطلاعات ارسال و تماس</h2><p><strong>تحویل‌گیرنده:</strong> @Model.FullName</p><p><strong>موبایل:</strong> <span dir="ltr">@Model.MobileNumber</span></p><p><strong>نشانی:</strong> @Model.Province، @Model.City، @Model.PostalAddress</p><p><strong>کد پستی:</strong> <span dir="ltr">@Model.PostalCode</span></p>@if(!string.IsNullOrWhiteSpace(Model.Notes)){<p><strong>توضیحات:</strong> @Model.Notes</p>}</div></div>
</div></main>
